<mujoco model="air_hockey_v0">
  <compiler angle="degree"/>
  <option timestep="0.002" gravity="0 0 0"/>

  <default>
    <geom friction="0.04 0.001 0.0001"/>
  </default>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1"/>
    <camera name="top" pos="0 0 1.4"
            xyaxes="1 0 0  0 1 0" fovy="48"/>

    <!-- MuJoCo에서 box의 size는 각 방향 전체 길이의 절반이다. -->
    <geom name="table" type="box" pos="0 0 -0.016"
          size="0.60 0.30 0.015" rgba="0.78 0.87 0.90 1"/>

    <!-- 중앙선과 골라인 표시는 충돌하지 않는다. -->
    <geom name="center_line" type="box" pos="0 0 0"
          size="0.002 0.30 0.0003" rgba="0.28 0.45 0.53 1"
          contype="0" conaffinity="0"/>
    <geom name="player_goal_line" type="box" pos="-0.60 0 0"
          size="0.001 0.10 0.0003" rgba="0.10 0.38 0.85 1"
          contype="0" conaffinity="0"/>
    <geom name="robot_goal_line" type="box" pos="0.60 0 0"
          size="0.001 0.10 0.0003" rgba="0.95 0.38 0.06 1"
          contype="0" conaffinity="0"/>

    <!-- 벽의 안쪽 면이 x=±0.60, y=±0.30에 오도록 배치한다. -->
    <geom name="upper_wall" type="box" pos="0 0.31 0.025"
          size="0.61 0.01 0.025" rgba="0.19 0.27 0.33 1"/>
    <geom name="lower_wall" type="box" pos="0 -0.31 0.025"
          size="0.61 0.01 0.025" rgba="0.19 0.27 0.33 1"/>

    <!-- 양 끝 벽은 두 조각으로 나누어 가운데 골문을 연다. -->
    <geom name="left_upper" type="box" pos="-0.61 0.20 0.025"
          size="0.01 0.10 0.025" rgba="0.19 0.27 0.33 1"/>
    <geom name="left_lower" type="box" pos="-0.61 -0.20 0.025"
          size="0.01 0.10 0.025" rgba="0.19 0.27 0.33 1"/>
    <geom name="right_upper" type="box" pos="0.61 0.20 0.025"
          size="0.01 0.10 0.025" rgba="0.19 0.27 0.33 1"/>
    <geom name="right_lower" type="box" pos="0.61 -0.20 0.025"
          size="0.01 0.10 0.025" rgba="0.19 0.27 0.33 1"/>

    <!-- 퍽은 높이가 고정되고 경기장 평면 안에서 이동·회전한다. -->
    <body name="puck" pos="-0.30 0 0.009">
      <joint name="puck_x" type="slide" axis="1 0 0"/>
      <joint name="puck_y" type="slide" axis="0 1 0"/>
      <joint name="puck_spin" type="hinge" axis="0 0 1"/>
      <geom type="cylinder" size="0.020 0.008"
            mass="0.025" rgba="0.08 0.09 0.11 1"/>
    </body>

    <!-- slide의 range는 각 패들의 시작 위치로부터 이동 가능한 거리다. -->
    <body name="player_paddle" pos="-0.45 0 0.018">
      <joint name="player_x" type="slide" axis="1 0 0"
             limited="true" range="-0.115 0.415"/>
      <joint name="player_y" type="slide" axis="0 1 0"
             limited="true" range="-0.265 0.265"/>
      <geom type="cylinder" size="0.035 0.017"
            mass="0.12" rgba="0.12 0.42 0.90 1"/>
    </body>

    <body name="robot_paddle" pos="0.45 0 0.018">
      <joint name="robot_x" type="slide" axis="1 0 0"
             limited="true" range="-0.415 0.115"/>
      <joint name="robot_y" type="slide" axis="0 1 0"
             limited="true" range="-0.265 0.265"/>
      <geom type="cylinder" size="0.035 0.017"
            mass="0.12" rgba="0.96 0.40 0.08 1"/>
    </body>
  </worldbody>
</mujoco>